# Cloudflare Pages response headers. Read when `wrangler pages dev` starts.
# No content hashing, so only versioned files get long cache lifetimes:
# htmx files carry their version in the name, and fonts are never overwritten
# (add a new file name instead). Everything else keeps Pages' default
# revalidation (max-age=0, must-revalidate).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
